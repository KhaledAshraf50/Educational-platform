@model EditCourseVM
@{
    Layout = "_InstructorDashboard";
}

<style>
    :root {
        --primary-color: #092C4C;
        --secondary-color: #F2994A;
        --success-color: #27ae60;
        --light-bg: #f8fafc;
        --card-bg: #ffffff;
    }

    body {
        background-color: var(--light-bg);
    }

    .edit-course {
        padding: 40px 20px;
        direction: rtl;
    }


        .edit-course .container {
            background: var(--card-bg);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }

    .sidebar:hover ~ .edit-course .container {
        margin-right: 220px;
    }

    h2, h4 {
        color: var(--primary-color);
        font-weight: bold;
        margin-bottom: 25px;
    }

    h2 {
        font-size: 32px;
        text-align: center;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--secondary-color);
    }

    h4 {
        font-size: 22px;
        margin-top: 30px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e0e0e0;
    }

    label {
        color: var(--primary-color);
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 15px;
        display: block;
    }

    .form-control, .form-select, textarea {
        padding: 12px 16px;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 15px;
        width: 100%;
    }

        .form-control:focus, .form-select:focus, textarea:focus {
            border-color: var(--secondary-color);
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(242, 153, 74, 0.25);
        }

    textarea {
        min-height: 120px;
        resize: vertical;
    }

    .mb-3 {
        margin-bottom: 20px;
    }

    img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        margin-top: 10px;
    }

    .btn-success {
        background-color: var(--success-color);
        border-color: var(--success-color);
        color: white;
        font-weight: 600;
        padding: 14px 40px;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 16px;
        border: none;
        margin-top: 20px;
    }

        .btn-success:hover {
            background-color: #229954;
            border-color: #229954;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
        }
</style>

<section class="edit-course mt-5">
    <div class="container">
        <h2>تعديل الكورس</h2>

        <form asp-action="EditCourse" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="CourseId" />

            <!-- الاسم والوصف والسعر -->
            <div class="mb-3">
                <label>اسم الكورس</label>
                <input type="text" class="form-control" asp-for="CourseName" />
            </div>

            <div class="mb-3">
                <label>وصف الكورس</label>
                <textarea class="form-control" asp-for="Description"></textarea>
            </div>

            <div class="mb-3">
                <label>سعر الكورس</label>
                <input type="number" class="form-control" asp-for="Price" min="0" step="0.01" />
            </div>

            <!-- الصورة -->
            <div class="mb-3">
                <label>الصورة الحالية</label><br />
                <img src="@Model.Image" alt="Course Image" width="200" class="mb-2" />
            </div>

            <div class="mb-3">
                <label>رفع صورة جديدة (اختياري)</label>
                <input type="file" name="CourseImage" class="form-control" />
            </div>

            <hr />
            <h4>محتوى الكورس</h4>

            <div class="mb-3">
                <label>اسم الفيديو/ملف 1</label>
                <input type="text" class="form-control" asp-for="NameUrl1" />
                <label>رابط 1</label>
                <input type="text" class="form-control" asp-for="Url1" />
            </div>

            <div class="mb-3">
                <label>اسم الفيديو/ملف 2</label>
                <input type="text" class="form-control" asp-for="NameUrl2" />
                <label>رابط 2</label>
                <input type="text" class="form-control" asp-for="Url2" />
            </div>

            <div class="mb-3">
                <label>اسم الفيديو/ملف 3</label>
                <input type="text" class="form-control" asp-for="NameUrl3" />
                <label>رابط 3</label>
                <input type="text" class="form-control" asp-for="Url3" />
            </div>

            <hr />
            <h4>الامتحان</h4>
            <div class="mb-3">
                <label>اسم الامتحان</label>
                <input type="text" class="form-control" asp-for="ExamName" />
            </div>

            <h4>الواجب</h4>
            <div class="mb-3">
                <label>اسم الواجب</label>
                <input type="text" class="form-control" asp-for="TaskName" />
            </div>

            <button type="submit" class="btn btn-success">حفظ التعديلات</button>
        </form>
    </div>
</section>