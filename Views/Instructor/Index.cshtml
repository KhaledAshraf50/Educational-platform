@model Luno_platform.Models.InstructorDashboardViewModel
@{
    Layout = "_InstructorDashboard";
}

<style>
    :root {
        /* الألوان الأساسية المطلوبة */
        --primary-color: #092C4C;
        --secondary-color: #F2994A;
        /* درجات مشتقة من الكحلي */
        --primary-light: #164069;
        --primary-soft: rgba(9, 44, 76, 0.05);
        /* درجات مشتقة من البرتقالي */
        --secondary-hover: #e08839;
        --secondary-soft: rgba(242, 153, 74, 0.1);
        /* ألوان الخلفية والنصوص */
        --light-bg: #f8fafc;
        --card-bg: #ffffff;
        --text-dark: #092C4C;
        --text-muted: #64748b;
        --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    body {
        background-color: var(--light-bg);
        color: var(--text-dark);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .content {
        padding: 40px 20px;
        direction: rtl;
    }

    /* Top Icons */
    .top-icons {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-bottom: 30px;
    }

    .icon-btn {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        border: 1px solid rgba(9, 44, 76, 0.1);
        background-color: var(--card-bg);
        color: var(--primary-color);
        font-size: 18px;
        cursor: pointer;
        transition: var(--transition);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .icon-btn:hover {
            background-color: var(--primary-color);
            color: white;
            transform: translateY(-2px);
        }

    /* Stats Section */
    .stat-card {
        background: var(--card-bg);
        padding: 25px;
        border-radius: 20px;
        border: none;
        border-right: 5px solid var(--secondary-color); /* شريط جانبي برتقالي */
        box-shadow: 0 10px 25px rgba(9, 44, 76, 0.05);
        transition: var(--transition);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(9, 44, 76, 0.1);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: var(--secondary-soft);
        color: var(--secondary-color);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        margin-bottom: 15px;
    }

    .stat-card h6 {
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 600;
    }

    .stat-card h4 {
        color: var(--primary-color);
        font-weight: 800;
        margin: 0;
    }

    /* Class Cards */
    .class-card {
        background: var(--card-bg);
        border-radius: 20px;
        padding: 30px;
        transition: var(--transition);
        border: 1px solid rgba(9, 44, 76, 0.05);
        position: relative;
        overflow: hidden;
    }

        .class-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(to left, var(--primary-color), var(--secondary-color));
        }

        .class-card:hover {
            box-shadow: 0 20px 40px rgba(9, 44, 76, 0.08);
            border-color: var(--secondary-color);
        }

    /* Buttons */
    .btn-custom-primary {
        background-color: var(--primary-color);
        color: white;
        border-radius: 10px;
        padding: 10px 20px;
        border: none;
        transition: var(--transition);
    }

        .btn-custom-primary:hover {
            background-color: var(--primary-light);
            color: white;
        }

    .btn-custom-secondary {
        background-color: var(--secondary-color);
        color: white;
        border-radius: 10px;
        padding: 10px 20px;
        border: none;
        transition: var(--transition);
    }

        .btn-custom-secondary:hover {
            background-color: var(--secondary-hover);
            color: white;
            box-shadow: 0 4px 15px rgba(242, 153, 74, 0.3);
        }

    /* Action Bar (The 3 main buttons) */
    .action-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin: 40px 0;
    }

    .action-btn {
        flex: 1;
        min-width: 180px;
        padding: 15px;
        border-radius: 15px;
        text-align: center;
        text-decoration: none !important;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: var(--transition);
    }

    /* زر إضافة كورس برتقالي */
    .btn-add-course {
        background: var(--secondary-color);
        color: white;
    }
    /* زر المهمة كحلي داكن */
    .btn-add-task {
        background: var(--primary-color);
        color: white;
    }
    /* زر الامتحان كحلي فاتح قليلاً */
    .btn-add-exam {
        background: var(--primary-light);
        color: white;
    }

    .action-btn:hover {
        opacity: 0.9;
        transform: translateY(-3px);
        color: white;
    }

    /* Add Class Form Section */
    .add-class-form-container {
        background: var(--primary-soft);
        padding: 30px;
        border-radius: 20px;
        border: 1px solid rgba(9, 44, 76, 0.1);
        margin-top: 30px;
    }

    .form-select {
        border: 1px solid rgba(9, 44, 76, 0.2);
        border-radius: 12px;
        padding: 12px;
    }

        .form-select:focus {
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px var(--secondary-soft);
        }

  

    }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert text-center shadow-sm" style="background: #fff; border-right: 5px solid var(--danger-color); color: var(--primary-color);">
        <i class="fa-solid fa-circle-exclamation me-2" style="color: var(--danger-color);"></i> @TempData["Error"]
    </div>
}

<div class="content">
    <div class="top-icons">
        <button class="icon-btn" title="الإشعارات">
            <i class="fa-solid fa-bell"></i>
        </button>
        <button class="icon-btn" title="الملف الشخصي">
            <i class="fa-solid fa-user-gear"></i>
        </button>
    </div>

    <div class="container">
        <div class="row g-4">
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-book-open"></i></div>
                    <h6>الكورسات</h6>
                    <h4>@Model.Courses.Count</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-chalkboard"></i></div>
                    <h6>الصفوف</h6>
                    <h4>@Model.Classes.Count</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-wallet"></i></div>
                    <h6>المبيعات</h6>
                    <h4>@Model.TotalSales</h4>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="stat-card">
                    <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
                    <h6>المتاحة</h6>
                    <h4>@Model.AvailableCourses</h4>
                </div>
            </div>
        </div>

        <div class="mt-5">
            <h5 class="fw-bold mb-4" style="color: var(--primary-color);">
                <i class="fa-solid fa-shapes me-2" style="color: var(--secondary-color);"></i> صفوفي الدراسية
            </h5>
            <div class="row g-4">
                @foreach (var cls in Model.Classes)
                {
                    <div class="col-md-4">
                        <div class="class-card">
                            <h6 class="fw-bold mb-3" style="color: var(--primary-color); font-size: 1.1rem;">@cls.ClassName</h6>
                            <p class="small text-muted mb-4">يحتوي هذا الصف على @cls.Courses.Count كورس مفعل.</p>

                            <div class="d-flex flex-column gap-2">
                                <form method="post" asp-action="ShowCoursesTeacher" asp-controller="Instructor">
                                    <input type="hidden" name="structorid" value="@Model.InstructorID" />
                                    <input type="hidden" name="classId" value="@cls.ClassID" />
                                    <button type="submit" class="btn btn-custom-primary w-100">
                                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> تصفح المحتوى
                                    </button>
                                </form>
                                <a class="btn btn-custom-secondary w-100" href="@Url.Action("AddCourse", "Instructor", new { classId = cls.ClassID })">
                                    <i class="fa-solid fa-plus me-1"></i> إضافة كورس
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="action-bar">
            <a class="action-btn btn-add-course" href="@Url.Action("AddCourse", "Instructor")">
                <i class="fa-solid fa-video"></i> كورس جديد
            </a>
            <a class="action-btn btn-add-task" href="@Url.Action("CreateTask", "Instructor")">
                <i class="fa-solid fa-file-pen"></i> واجب جديد
            </a>
            <a class="action-btn btn-add-exam" href="@Url.Action("CreateExam", "Instructor")">
                <i class="fa-solid fa-graduation-cap"></i> امتحان جديد
            </a>
        </div>

        <div class="add-class-form-container">
            <h6 class="fw-bold mb-3" style="color: var(--primary-color);">
                <i class="fa-solid fa-link me-2" style="color: var(--secondary-color);"></i> ربط صف دراسي جديد
            </h6>
            <form asp-action="AddClassToInstructor" method="post" class="row g-3 align-items-end">
                <input type="hidden" asp-for="InstructorID" />
                <div class="col-md-9">
                    <select class="form-select" asp-for="SelectedClassID" asp-items="@(new SelectList(Model.AllClasses, "ClassID", "ClassName"))">
                        <option value="">اختر من قائمة الصفوف المتاحة...</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-custom-secondary w-100 py-2 fw-bold">إضافة الصف</button>
                </div>
            </form>
        </div>
    </div>
</div>