@model Luno_platform.Viewmodel.DashboardVM
@{
    Layout = "_InstructorDashboard";
}
@section stylee {
    <link rel="stylesheet" href="~/assets/css/examtasks.css">
}
@if (TempData["Success"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-4">
        <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}   
<style>
    :root {
        --primary-color: #092C4C;
        --secondary-color: #F2994A;
        --success-color: #27ae60;
        --info-color: #3498db;
        --warning-color: #e2b93b;
        --danger-color: #e74c3c;
        --light-bg: #f8fafc;
        --card-bg: #ffffff;
    }

    .content {
        padding: 30px;
        direction: rtl;
        background-color: var(--light-bg);
    }

    h4 {
        color: var(--primary-color);
        font-weight: bold;
        font-size: 28px;
        margin-bottom: 30px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

        .stats .card {
            background: var(--card-bg);
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border-right: 4px solid var(--secondary-color);
            transition: all 0.3s ease;
            text-align: center;
        }

            .stats .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
            }

            .stats .card h5 {
                color: var(--primary-color);
                font-weight: bold;
                font-size: 32px;
                margin: 0 0 10px 0;
            }

            .stats .card p {
                color: #666;
                font-size: 15px;
                margin: 0;
            }

    .nav-tabs {
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 25px;
    }

        .nav-tabs .nav-link {
            color: #666;
            font-weight: 600;
            font-size: 16px;
            padding: 12px 24px;
            border: none;
            background: none;
            transition: all 0.3s ease;
        }

            .nav-tabs .nav-link.active {
                color: white;
                background: linear-gradient(135deg, var(--primary-color) 0%, #0a3d5c 100%);
                border-radius: 8px 8px 0 0;
            }

            .nav-tabs .nav-link:hover:not(.active) {
                color: var(--secondary-color);
                background-color: rgba(242, 153, 74, 0.1);
            }

    .add-btn {
        background-color: var(--success-color);
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .add-btn:hover {
            background-color: #229954;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(39, 174, 96, 0.3);
        }

    .btn-success {
        background-color: var(--success-color);
        border-color: var(--success-color);
        font-weight: 600;
        padding: 10px 20px;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-success:hover {
            background-color: #229954;
            border-color: #229954;
            transform: translateY(-2px);
        }

    .table_Edit {
        background: var(--card-bg);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

        .table_Edit thead {
            background: linear-gradient(135deg, var(--primary-color) 0%, #0a3d5c 100%);
            color: white;
        }

            .table_Edit thead th {
                border: none;
                font-weight: 700;
                padding: 18px 15px;
                font-size: 15px;
                text-align: center;
            }

        .table_Edit tbody tr {
            transition: all 0.3s ease;
            border-bottom: 1px solid #f0f0f0;
        }

            .table_Edit tbody tr:hover {
                background: rgba(242, 153, 74, 0.05);
            }

        .table_Edit tbody td, .table_Edit tbody th {
            padding: 18px 15px;
            vertical-align: middle;
            color: #333;
            font-size: 14px;
            text-align: center;
        }

    .action-btn {
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 13px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-view {
        background-color: var(--info-color);
        color: white;
    }

        .btn-view:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
        }

    .btn-edit {
        background-color: var(--secondary-color);
        color: white;
    }

        .btn-edit:hover {
            background-color: #e08839;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(242, 153, 74, 0.3);
        }

    .btn-questions {
        background-color: var(--primary-color);
        color: white;
    }

        .btn-questions:hover {
            background-color: #0a3d5c;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(9, 44, 76, 0.3);
        }

    .btn-danger {
        background-color: var(--danger-color);
        color: white;
    }

        .btn-danger:hover {
            background-color: #c0392b;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
        }
</style>

<div class="content">

    <h4>📝 إدارة الواجبات والامتحانات</h4>

    <!-- Stats -->
    <div class="stats">
        <div class="card">
            <h5>@Model.TotalAssignments</h5>
            <p>عدد الواجبات</p>
        </div>
        <div class="card">
            <h5>@Model.TotalExams</h5>
            <p>الامتحانات القادمة</p>
        </div>
        <div class="card">
            <h5>@Model.StudentsSubmitted / @Model.StudentsTotalAssignments</h5>
            <p>طلاب سلموا الواجبات</p>
        </div>
        <div class="card">
            <h5>@Model.StudentsTakenExams / @Model.StudentsTotalExams</h5>
            <p>طلاب أدوا الامتحانات</p>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#assignments">الواجبات</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#exams">الامتحانات</button>
        </li>
    </ul>

    <div class="tab-content">

        <!-- الواجبات -->
        <div class="tab-pane fade show active" id="assignments">

            <!-- زر إضافة واجب جديد -->
            <div class="mb-3 text-end">
                <button class="add-btn" data-bs-toggle="modal" data-bs-target="#addAssignmentModal">
                    <i class="fa-solid fa-plus"></i> إضافة واجب جديد
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-striped table_Edit text-center align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>اسم الواجب</th>
                            <th>الصف الدراسي</th>
                            <th>عدد الأسئلة</th>
                            <th>الطلاب سلموا / الكلي</th>
                            <th>التحكم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Assignments)
                        {
                            <tr>
                                <th>@a.Id</th>
                                <td>@a.Name</td>
                                <td>@a.Class</td>
                                <td>@a.TotalQuestions أسئلة</td>
                                <td>@a.StudentsSubmitted / @a.TotalStudents</td>
                                <td>
                                    <div class="d-flex flex-wrap justify-content-center">
                                        <button class="action-btn btn-view me-1 mb-1 mb-sm-0">عرض</button>
                                        <button class="action-btn btn-edit me-1 mb-1 mb-sm-0">تعديل</button>
                                        <button class="action-btn btn-questions" onclick="window.location.href='assignment-questions.html?id=@a.Id'">الأسئلة</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- الامتحانات -->
        <div class="tab-pane fade" id="exams">

            <div class="mb-3 text-end">
                <a href="/Instructor/CreateExam" class="btn btn-success">
                    ➕ إضافة امتحان جديد
                </a>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-striped table_Edit text-center align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>اسم الامتحان</th>
                            <th>الصف الدراسي</th>
                            <th>عدد الأسئلة</th>
                            <th>المدة</th>
                            <th>طلاب أدوا / الكلي</th>
                            <th>التحكم</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model.Exams)
                        {
                            <tr>
                                <th>@e.Id</th>
                                <td>@e.Name</td>
                                <td>@e.Class</td>
                                <td>@e.TotalQuestions سؤال</td>
                                <td>@e.Duration دقيقة</td>
                                <td>@e.StudentsTaken / @e.TotalStudents</td>
                                <td>
                                    <div class="d-flex flex-wrap justify-content-center">
                                        <button class="action-btn btn-view me-1 mb-1 mb-sm-0"
                                                onclick="window.location.href='@Url.Action("ViewExamQuestions", "Instructor", new { id = e.Id })'">
                                            عرض
                                        </button>

                                        <button class="action-btn btn-edit me-1 mb-1 mb-sm-0"
                                                onclick="window.location.href='@Url.Action("EditExam", "Instructor", new { id = e.Id })'">
                                            تعديل
                                        </button>

                                        <button class="action-btn btn-danger me-1 mb-1 mb-sm-0"
                                                onclick="confirmDelete(@e.Id)">
                                            حذف
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>
<script>
    function confirmDelete(examId) {

        if (confirm("⚠️ هل أنت متأكد من حذف الامتحان؟ سيتم حذف كل الأسئلة المرتبطة به!")) {
            window.location.href =
                '@Url.Action("DeleteExam", "Instructor")' + '?id=' + examId;
        }
    }
</script>