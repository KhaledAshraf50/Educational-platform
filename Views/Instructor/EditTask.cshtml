@model Luno_platform.Viewmodel.AddTaskQuestionVM
@{
    Layout = "_InstructorDashboard";
}

<div class="container view-questions-page mt-5">

    <h2 class="page-title">تعديل أسئلة الواجب</h2>

    <form asp-action="EditTask" method="post">
        <input type="hidden" asp-for="TaskId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            <div class="question-view-card">

                <div class="header">
                    سؤال @(i + 1)
                </div>

                <!-- Question Text -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">نص السؤال</label>
                    <input asp-for="Questions[@i].QuestionText"
                           class="form-control form-control-lg" />
                </div>

                <!-- Choices -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">A</label>
                        <input asp-for="Questions[@i].ChooseA"
                               class="form-control form-control-lg choice-input"
                               data-q="@i" data-choice="A" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">B</label>
                        <input asp-for="Questions[@i].ChooseB"
                               class="form-control form-control-lg choice-input"
                               data-q="@i" data-choice="B" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">C</label>
                        <input asp-for="Questions[@i].ChooseC"
                               class="form-control form-control-lg choice-input"
                               data-q="@i" data-choice="C" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-semibold">D</label>
                        <input asp-for="Questions[@i].ChooseD"
                               class="form-control form-control-lg choice-input"
                               data-q="@i" data-choice="D" />
                    </div>
                </div>

                <!-- Correct Answer -->
                <div class="correct-answer">
                    <label class="fw-semibold">الإجابة الصحيحة</label>
                    <select asp-for="Questions[i].CorrectAnswer"
                            class="form-select correct-answer-select"
                            data-q="@i">
                        <option value="">اختر الإجابة</option>
                        <option value="@Model.Questions[i].ChooseA">
                            @Model.Questions[i].ChooseA
                        </option>
                        <option value="@Model.Questions[i].ChooseB">
                            @Model.Questions[i].ChooseB
                        </option>
                        <option value="@Model.Questions[i].ChooseC">
                            @Model.Questions[i].ChooseC
                        </option>
                        <option value="@Model.Questions[i].ChooseD">
                            @Model.Questions[i].ChooseD
                        </option>
                    </select>
                </div>

            </div>
        }

        <div class="text-center mt-4">
            <button type="submit" class="btn-back w-100">
                حفظ التعديلات
            </button>
        </div>
    </form>

</div>

<!-- ================= STYLE ================= -->
<style>
    :root {
        --primary: #092c4c;
        --secondary: #F2994A;
        --soft-bg: #f6f9fc;
    }

    body {
        background: var(--soft-bg);
    }

    .view-questions-page {
        max-width: 950px;
        padding: 35px 10px;
        margin: auto;
    }

    .page-title {
        text-align: center;
        color: var(--primary);
        font-weight: 800;
        margin-bottom: 35px;
        font-size: 2rem;
    }

    .question-view-card {
        background: #fff;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        border-right: 6px solid var(--secondary);
        box-shadow: 0px 6px 16px rgba(0,0,0,0.06);
        transition: 0.25s ease;
    }

        .question-view-card:hover {
            transform: translateY(-4px);
            box-shadow: 0px 10px 30px rgba(0,0,0,0.1);
        }

        .question-view-card .header {
            background: linear-gradient(135deg, var(--primary), #104b7e);
            color: white;
            padding: 6px 16px;
            border-radius: 20px;
            width: fit-content;
            font-weight: 700;
            margin-bottom: 20px;
        }

    .btn-back {
        background: linear-gradient(135deg, var(--primary), #1268a5);
        color: white;
        font-weight: bold;
        padding: 12px 35px;
        border-radius: 30px;
        border: none;
        transition: .25s ease;
    }

        .btn-back:hover {
            background: linear-gradient(135deg, var(--secondary), #ffb356);
            transform: translateY(-2px);
            color: white;
        }
</style>

<!-- ================= SCRIPT ================= -->
<script>
    document.querySelectorAll('.choice-input').forEach(input => {
        input.addEventListener('input', function () {

            const qIndex = this.dataset.q;
            const choice = this.dataset.choice;
            const select = document.querySelector(
                `.correct-answer-select[data-q='${qIndex}']`
            );

            if (!select) return;

            const optionMap = { A: 1, B: 2, C: 3, D: 4 };
            const option = select.options[optionMap[choice]];

            const wasSelected = option.selected;

            option.text = this.value;
            option.value = this.value;

            if (wasSelected) {
                select.value = this.value;
            }
        });
    });
</script>
